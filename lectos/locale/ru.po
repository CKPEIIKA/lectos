msgid "Navigation"
msgstr "Навигация"

msgid "Notes"
msgstr "Заметки"

msgid "Timer"
msgstr "Таймер"

msgid "Projector"
msgstr "Проектор"

msgid "Drawing"
msgstr "Рисование"

msgid "Laser"
msgstr "Лазер"

msgid "View"
msgstr "Вид"

msgid "General"
msgstr "Общее"

msgid "Next slide, or N slides forward."
msgstr "Следующий слайд или на N слайдов вперёд."

msgid "Previous slide, or N slides back."
msgstr "Предыдущий слайд или на N слайдов назад."

msgid "Go to slide N. A bare number does the same: :12"
msgstr "Перейти к слайду N. Просто число делает то же: :12"

msgid "Go to the first slide."
msgstr "Перейти к первому слайду."

msgid "Go to the last slide. :$ does the same."
msgstr "Перейти к последнему слайду. :$ делает то же."

msgid "List or grid of all slides; pick one to go there."
msgstr "Список или сетка всех слайдов; выберите слайд, чтобы перейти к нему."

msgid "Leave the overview, search or help and return to the main view."
msgstr "Закрыть обзор, поиск или справку и вернуться к слайдам."

msgid "Search slide text and notes. /TEXT does the same."
msgstr "Искать в тексте слайдов и заметок. /ТЕКСТ делает то же."

msgid "Next search hit (key n)."
msgstr "Следующее найденное место (клавиша n)."

msgid "Previous search hit (key N)."
msgstr "Предыдущее найденное место (клавиша N)."

msgid "Whether a note hit also previews its slide (never moves the projector)."
msgstr "Показывать ли слайд для найденной заметки (проектор не переключается)."

msgid "Scroll the notes down."
msgstr "Прокрутить заметки вниз."

msgid "Scroll the notes up."
msgstr "Прокрутить заметки вверх."

msgid "Start or pause the timer."
msgstr "Запустить или поставить таймер на паузу."

msgid "Stop the timer and set it to zero."
msgstr "Остановить таймер и обнулить его."

msgid "Planned lecture length, e.g. 90, 1h30, 1:30 or 45m; drives the time left."
msgstr "Запланированная длительность лекции, например 90, 1h30, 1:30 или 45m; от неё считается оставшееся время."

msgid "Hold the projector on its slide while you browse; unfreezing catches it up."
msgstr "Удерживать проектор на текущем слайде, пока вы листаете; при снятии заморозки проектор догоняет."

msgid "Black out the projector (shows the standby screen if configured)."
msgstr "Погасить проектор (покажет экран ожидания, если он настроен)."

msgid "Show the chalkboard instead of the slide."
msgstr "Показать доску вместо слайда."

msgid "Chalkboard background: chalk, black, white, ruled, grid."
msgstr "Фон доски: chalk (мел), black, white, ruled (линейка), grid (клетка)."

msgid "Fullscreen for the console window (GTK) or the projector (terminal)."
msgstr "Полный экран для окна консоли (GTK) или проектора (терминал)."

msgid "Fullscreen for the projector window."
msgstr "Полный экран для окна проектора."

msgid "Let the mouse draw (a pen always draws)."
msgstr "Разрешить рисовать мышью (перо рисует всегда)."

msgid "Erase whole strokes you touch instead of drawing."
msgstr "Стирать целиком штрихи, которых касаетесь, вместо рисования."

msgid "Wide translucent strokes instead of pen strokes."
msgstr "Широкие полупрозрачные штрихи вместо штрихов пера."

msgid "Pen colour: red, yellow, green, blue, white, black."
msgstr "Цвет пера: red, yellow, green, blue, white, black или #rrggbb."

msgid "Pen width 1..40."
msgstr "Толщина пера 1..40."

msgid "Smooth finished strokes, 0 (off) to 5."
msgstr "Сглаживать готовые штрихи, от 0 (выкл.) до 5."

msgid "Eraser radius, 4..80."
msgstr "Радиус ластика, 4..80."

msgid "Highlighter opacity, 0.1..0.9."
msgstr "Непрозрачность маркера, 0.1..0.9."

msgid "Undo the last ink change on this slide (or the board)."
msgstr "Отменить последнее изменение рисунка на этом слайде (или на доске)."

msgid "Redo it."
msgstr "Вернуть отменённое."

msgid "Erase all ink on this slide (or the board); undo brings it back."
msgstr "Стереть все рисунки на этом слайде (или на доске); отмена вернёт их."

msgid "Erase ALL ink on every slide and the board; undo restores a layer at a time."
msgstr "Стереть ВСЕ рисунки на всех слайдах и на доске; отмена возвращает слой за слоем."

msgid "Bring back the ink the last clear-all erased."
msgstr "Вернуть рисунки, стёртые последней командой clear-all."

msgid "Write the slides with your ink to a new PDF (never overwrites)."
msgstr "Записать слайды с вашими рисунками в новый PDF (существующие файлы не перезаписываются)."

msgid "Laser pointer: the dot follows the mouse over the large preview."
msgstr "Лазерная указка: точка следует за мышью над большим просмотром."

msgid "Laser colour."
msgstr "Цвет лазера."

msgid "Laser radius in pixels, 3..30."
msgstr "Радиус лазера в пикселях, 3..30."

msgid "Laser shape: dot, ring, cross."
msgstr "Форма лазера: dot (точка), ring (кольцо), cross (крест)."

msgid "Slides shown after the current one in the wide layout's filmstrip, 0..16."
msgstr "Сколько слайдов после текущего показывать в ленте широкой раскладки, 0..16."

msgid "Slides shown before the current one in the filmstrip, 0..8."
msgstr "Сколько слайдов перед текущим показывать в ленте, 0..8."

msgid "Vim-style keys in the GTK console."
msgstr "Клавиши в стиле Vim в консоли GTK."

msgid "List every command with usage and keys, or describe one."
msgstr "Показать все команды с описанием и клавишами или описать одну."

msgid "Save and quit. q does the same."
msgstr "Сохранить и выйти. q делает то же."

msgid "Same as quit."
msgstr "То же, что quit."

